{
  "name": "wave-player",
  "productName": "Wave",
  "version": "0.1.0",
  "private": true,
  "description": "Неофициальный клиент Яндекс Музыки с собственным интерфейсом",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "vite build && electron .",
    "electron": "electron .",
    "test:api": "node --experimental-strip-types tests/api.test.ts",
    "test:e2e": "vite build && node tests/e2e.mjs",
    "dist": "vite build && electron-builder --win",
    "test:wave": "node --experimental-strip-types tests/wave.test.ts"
  },
  "build": {
    "appId": "local.wave.player",
    "productName": "Wave",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
