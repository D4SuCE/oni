{
  "name": "wave-player",
  "productName": "Oni",
  "version": "1.5.2",
  "private": true,
  "description": "Неофициальный клиент Яндекс Музыки с собственным интерфейсом",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "vite build && electron .",
    "electron": "electron .",
    "test:api": "node --experimental-strip-types tests/api.test.ts",
    "test:e2e": "vite build && node tests/e2e.mjs && node tests/desktop.mjs && node tests/update.mjs && node tests/login.mjs && node tests/offline.mjs",
    "dist": "vite build && electron-builder --win --publish never",
    "test:wave": "node --experimental-strip-types tests/wave.test.ts",
    "lint": "oxlint",
    "check": "npm run typecheck && npm run lint && npm run test:wave && npm run test:recs && npm run test:beat && npm run test:offline && npm run test:links",
    "icons": "node scripts/icons.mjs",
    "test:recs": "node --experimental-strip-types tests/recs.test.ts",
    "brush-font": "python scripts/brush-font.py node_modules/@fontsource/yuji-boku",
    "test:beat": "node --experimental-strip-types tests/beat.test.ts",
    "test:offline": "node --experimental-strip-types tests/offline.test.ts",
    "test:links": "node --experimental-strip-types tests/links.test.ts",
    "release": "node scripts/release.mjs",
    "screenshots": "vite build && node scripts/screenshots.mjs"
  },
  "build": {
    "appId": "local.wave.player",
    "productName": "Oni",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Oni",
      "artifactName": "Oni-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Oni-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "D4SuCE",
        "repo": "oni-releases",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/yuji-boku": "^5.3.1",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.60.0",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "author": "D4SuCE",
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "electron-updater": "^6.8.9"
  }
}
